---
import gallery from '../data/gallery.json';
interface Props { heading?: string; subheading?: string; limit?: number; showFilters?: boolean; background?: 'white' | 'gray'; }
const {
  heading = 'Recent kitchen projects',
  subheading = 'Real cabinet and kitchen work from homes across Tampa Bay.',
  limit = 0,
  showFilters = false,
  background = 'white',
} = Astro.props as Props;
let items = gallery.items;
if (limit > 0) items = items.slice(0, limit);
const categories = ['All', ...Array.from(new Set(items.map((i) => i.category)))];
const sm = (src: string) => src.replace(/\.webp$/, '-sm.webp');
const bg = background === 'gray' ? 'bg-gray-50' : 'bg-white';
---
<section id="gallery" class={`py-16 sm:py-20 ${bg}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-sm mb-2">Gallery</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-[#1a2b4a]">{heading}</h2>
      <p class="text-lg text-gray-600 mt-3 max-w-2xl mx-auto">{subheading}</p>
    </div>

    {showFilters && categories.length > 2 && (
      <div class="flex flex-wrap justify-center gap-2 mb-8">
        {categories.map((c, i) => (
          <button type="button" class={i === 0 ? 'px-4 py-2 rounded-full text-sm font-semibold transition-all bg-[#1a2b4a] text-white shadow-lg' : 'px-4 py-2 rounded-full text-sm font-semibold transition-all bg-white text-[#1a2b4a] border border-gray-200'}>{c}</button>
        ))}
      </div>
    )}

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
      {items.map((img) => (
        <div class="cursor-pointer group relative aspect-[4/3] rounded-xl overflow-hidden shadow-md">
          <img
            src={img.src}
            srcset={`${sm(img.src)} 640w, ${img.src} 1280w`}
            sizes="(max-width: 768px) 50vw, 25vw"
            alt={img.alt} loading="lazy" decoding="async" width="640" height="480"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-[#1a2b4a]/0 group-hover:bg-[#1a2b4a]/30 transition-colors flex items-center justify-center">
            <svg class="w-10 h-10 text-white opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <p class="gallery-cat sr-only">{img.category}</p>
        </div>
      ))}
    </div>
  </div>
</section>
