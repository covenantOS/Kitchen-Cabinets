---
import { getCollection } from 'astro:content';
interface Props { heading?: string; subheading?: string; eyebrow?: string; }
const {
  eyebrow = 'What We Do',
  heading = 'Kitchen cabinet services for Tampa Bay',
  subheading = 'From a fresh coat of paint to a full custom kitchen, we do one thing and do it well: cabinets and the kitchens they live in.',
} = Astro.props as Props;
const services = (await getCollection('services'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const sm = (src: string) => src.replace(/\.webp$/, '-sm.webp');
---
<section class="py-16 sm:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-sm mb-2">{eyebrow}</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-[#1a2b4a]">{heading}</h2>
      <p class="text-lg text-gray-600 mt-3 max-w-2xl mx-auto">{subheading}</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((s) => {
        const img = s.data.cardImage || s.data.heroImage;
        return (
          <a href={`/${s.id}`} class="group bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-xl transition-all duration-300 flex flex-col">
            <div class="relative aspect-[16/10] overflow-hidden">
              <img
                src={img}
                srcset={`${sm(img)} 640w, ${img} 1280w`}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                alt={`${s.data.shortName} in Tampa`}
                loading="lazy" decoding="async" width="640" height="400"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-xl font-bold text-[#1a2b4a] mb-2 group-hover:text-[#c9a227] transition-colors">{s.data.shortName}</h3>
              <p class="text-gray-600 text-sm leading-relaxed flex-1">{s.data.cardDescription}</p>
              {s.data.priceAnchor && <p class="text-sm font-semibold text-[#1a2b4a] mt-3">{s.data.priceAnchor}</p>}
              <span class="inline-flex items-center gap-1 text-[#c9a227] font-semibold text-sm mt-4">
                Learn more
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
