---
import Logo from './Logo.astro';
import { site, telHref, fullAddress } from '../lib/site';

const services = [
  { title: 'Kitchen Cabinets', href: '/custom-kitchen-cabinets-tampa' },
  { title: 'Kitchen Remodeling', href: '/kitchen-remodeling-tampa' },
  { title: 'Countertops', href: '/kitchen-countertops-tampa' },
  { title: 'Cabinet Refacing', href: '/kitchen-cabinet-refacing-tampa' },
  { title: 'Cabinet Installation', href: '/kitchen-cabinet-installation-tampa' },
  { title: 'Cabinet Painting', href: '/kitchen-cabinet-painting-tampa' },
];

const areas = [
  { title: 'Westchase', href: '/service-areas/westchase' },
  { title: 'Carrollwood', href: '/service-areas/carrollwood' },
  { title: 'South Tampa', href: '/service-areas/south-tampa' },
  { title: 'New Tampa', href: '/service-areas/new-tampa' },
  { title: 'Citrus Park', href: '/service-areas/citrus-park' },
  { title: 'Brandon', href: '/service-areas/brandon' },
  { title: 'Riverview', href: '/service-areas/riverview' },
];

const company = [
  { title: 'About Us', href: '/about' },
  { title: 'Our Process', href: '/process' },
  { title: 'Gallery', href: '/gallery' },
  { title: 'Reviews', href: '/reviews' },
  { title: 'Financing', href: '/financing' },
  { title: 'Warranty', href: '/warranty' },
  { title: 'Contact', href: '/contact' },
];

const year = new Date().getFullYear();
---

<footer class="bg-[#1a2b4a] text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-12">
      <div class="lg:col-span-2">
        <a href="/" class="inline-flex" aria-label={`${site.brandName} home`}>
          <Logo class="text-white" />
        </a>
        <p class="text-gray-400 mt-4 mb-6 max-w-sm">
          {site.tagline}. Kitchen cabinet painting, refacing, custom cabinets, installation, and full kitchen remodeling for Tampa Bay homes. Licensed, insured, and backed by a written workmanship warranty.
        </p>
        <div class="space-y-3">
          <a href={telHref} class="flex items-center gap-3 text-[#c9a227] hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            <span class="font-semibold">{site.phoneDisplay}</span>
          </a>
          <a href={`mailto:${site.email}`} class="flex items-center gap-3 text-gray-400 hover:text-[#c9a227] transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            <span>{site.email}</span>
          </a>
          <div class="flex items-start gap-3 text-gray-400">
            <svg class="w-5 h-5 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <span>{fullAddress}</span>
          </div>
        </div>

        {/* Our Sister Company — cross-link to Westchase Painting */}
        <div class="mt-6 pt-6 border-t border-white/10">
          <p class="text-xs uppercase tracking-wider text-gray-500 mb-3 font-semibold">Our Sister Company</p>
          <a href={site.sisterUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg px-4 py-3 transition-colors group">
            <svg class="w-5 h-5 text-[#c9a227]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" /></svg>
            <span>
              <span class="block text-sm font-semibold text-white group-hover:text-[#c9a227] transition-colors">{site.sisterName}</span>
              <span class="block text-xs text-gray-400">Interior, exterior &amp; cabinet painting in Tampa Bay</span>
            </span>
          </a>
        </div>

        {(site.social.facebook || site.social.instagram || site.social.googleProfile) && (
          <div class="mt-6">
            <p class="text-xs uppercase tracking-wider text-gray-500 mb-3 font-semibold">Follow Us</p>
            <div class="flex items-center gap-3">
              {site.social.facebook && (
                <a href={site.social.facebook} target="_blank" rel="noopener" class="w-9 h-9 rounded-full bg-white/5 hover:bg-[#1877F2] border border-white/10 flex items-center justify-center transition-colors" aria-label="Facebook">
                  <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                </a>
              )}
              {site.social.instagram && (
                <a href={site.social.instagram} target="_blank" rel="noopener" class="w-9 h-9 rounded-full bg-white/5 hover:bg-gradient-to-br hover:from-[#833AB4] hover:via-[#FD1D1D] hover:to-[#F77737] border border-white/10 flex items-center justify-center transition-all" aria-label="Instagram">
                  <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                </a>
              )}
            </div>
          </div>
        )}
      </div>

      <div>
        <p class="font-bold text-lg mb-4 text-white">Services</p>
        <ul class="space-y-2">
          {services.map((s) => (
            <li><a href={s.href} class="text-gray-400 hover:text-[#c9a227] transition-colors text-sm">{s.title}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="font-bold text-lg mb-4 text-white">Service Areas</p>
        <ul class="space-y-2">
          {areas.map((a) => (
            <li><a href={a.href} class="text-gray-400 hover:text-[#c9a227] transition-colors text-sm">{a.title}</a></li>
          ))}
          <li><a href="/service-areas" class="text-[#c9a227] hover:text-white transition-colors text-sm font-semibold">All areas →</a></li>
        </ul>
      </div>

      <div>
        <p class="font-bold text-lg mb-4 text-white">Company</p>
        <ul class="space-y-2">
          {company.map((c) => (
            <li><a href={c.href} class="text-gray-400 hover:text-[#c9a227] transition-colors text-sm">{c.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
        <div class="flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
          <p class="text-gray-400 text-sm">&copy; {year} {site.legalEntity}. {site.attribution}.</p>
          <div class="flex flex-wrap justify-center md:justify-start items-center gap-x-4 gap-y-1 text-xs text-gray-500">
            <a href="/privacy-policy" class="hover:text-[#c9a227]">Privacy Policy</a>
            <span class="text-gray-700">|</span>
            <a href="/cookie-policy" class="hover:text-[#c9a227]">Cookie Policy</a>
            <span class="text-gray-700">|</span>
            <a href="/terms" class="hover:text-[#c9a227]">Terms</a>
            <span class="text-gray-700">|</span>
            <a href="/sitemap" class="hover:text-[#c9a227]">Site Map</a>
          </div>
        </div>
        <div class="flex items-center gap-6 text-sm text-gray-400">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
            Licensed &amp; Insured
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#c9a227]" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4zM18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 110 2H5a1 1 0 01-1-1z" /></svg>
            Financing Available
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>
