---
import { site, telHref } from '../lib/site';
interface Props { title?: string; description?: string; }
const {
  title = 'Ready to transform your kitchen?',
  description = "Get a free, no-pressure estimate from Tampa's kitchen cabinet specialists.",
} = Astro.props as Props;
---
<section class="py-16 bg-[#1a2b4a]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{title}</h2>
    <p class="text-xl text-gray-300 mb-8">{description}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/contact" data-cta="cta_section_estimate" class="inline-flex items-center justify-center px-8 py-4 bg-[#c9a227] text-[#1a2b4a] font-bold text-lg rounded-lg hover:bg-[#d4b84a] transition-all duration-300">Get a Free Estimate</a>
      <a href={telHref} data-cta="cta_section_call" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-bold text-lg rounded-lg hover:bg-white hover:text-[#1a2b4a] transition-all duration-300">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Call {site.phoneDisplay}
      </a>
    </div>
  </div>
</section>
