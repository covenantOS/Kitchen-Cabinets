---
import reviews from '../data/reviews.json';
import { site } from '../lib/site';
interface Props { heading?: string; limit?: number; }
const { heading = 'What Tampa Bay homeowners say', limit = 6 } = Astro.props as Props;
const items = reviews.items.slice(0, limit);
const Star = '<svg class="w-5 h-5 text-[#FBBC05]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>';
---
<section class="py-16 sm:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-sm mb-2">Reviews</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-[#1a2b4a]">{heading}</h2>
      <p class="text-lg text-gray-600 mt-3 max-w-2xl mx-auto">
        Backed by 25+ years of Tampa Bay home remodeling experience.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((r) => (
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 flex flex-col">
          <div class="flex mb-3">{Array.from({ length: r.rating }).map(() => <Fragment set:html={Star} />)}</div>
          <p class="text-gray-700 leading-relaxed flex-1">&ldquo;{r.text}&rdquo;</p>
          <div class="mt-4 pt-4 border-t border-gray-100">
            <p class="font-semibold text-[#1a2b4a]">{r.name} <span class="font-normal text-gray-500">&bull; {r.location}</span></p>
            <p class="text-xs text-gray-400 mt-0.5">{r.via}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="text-center mt-10">
      <a href="/reviews" class="inline-flex items-center gap-2 text-[#1a2b4a] font-semibold hover:text-[#c9a227] transition-colors">
        Read more reviews
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</section>
