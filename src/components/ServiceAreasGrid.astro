---
import { getCollection } from 'astro:content';
const areas = (await getCollection('areas'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const sm = (src: string) => src.replace(/\.webp$/, '-sm.webp');
---
<section class="py-16 sm:py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-sm mb-2">Where We Work</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-[#1a2b4a]">Tampa Bay Service Areas</h2>
      <p class="text-lg text-gray-600 mt-3 max-w-2xl mx-auto">We bring the kitchen showroom to you across Tampa and the surrounding communities.</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {areas.map((a) => (
        <a href={`/service-areas/${a.id}`} class="group relative aspect-[4/3] rounded-xl overflow-hidden shadow-md">
          <img
            src={a.data.heroImage}
            srcset={`${sm(a.data.heroImage)} 640w, ${a.data.heroImage} 1280w`}
            sizes="(max-width: 768px) 50vw, 25vw"
            alt={`Kitchen cabinet projects in ${a.data.neighborhood}`}
            loading="lazy" decoding="async"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            width="640" height="480"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#1a2b4a]/85 via-[#1a2b4a]/20 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-4">
            <span class="text-white font-bold text-lg">{a.data.neighborhood}</span>
            <span class="block text-[#c9a227] text-xs font-semibold opacity-0 group-hover:opacity-100 transition-opacity">View kitchens →</span>
          </div>
        </a>
      ))}
      <a href="/service-areas" class="flex flex-col items-center justify-center aspect-[4/3] rounded-xl bg-[#1a2b4a] text-white p-4 text-center hover:bg-[#2a3d5c] transition-colors">
        <svg class="w-8 h-8 text-[#c9a227] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        <span class="font-bold">All Service Areas</span>
        <span class="text-xs text-gray-300 mt-1">See everywhere we serve</span>
      </a>
    </div>
  </div>
</section>
