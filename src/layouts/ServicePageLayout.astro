---
import BaseLayout from './BaseLayout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import FloatingCallBadge from '../components/FloatingCallBadge.astro';
import ExitIntentPopup from '../components/ExitIntentPopup.astro';
import AnalyticsListeners from '../components/AnalyticsListeners.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import { site, telHref } from '../lib/site';

interface ServiceData {
  title: string; shortName: string; pageTitle: string; description: string; breadcrumb: string;
  heroSubtitle: string; heroImage: string; priceAnchor?: string;
  process: Array<{ title: string; description: string }>;
  faqItems: Array<{ q: string; a: string }>;
  gallery: Array<{ src: string; alt: string; label?: string }>;
  beforeAfter: Array<{ before: string; after: string; beforeAlt: string; afterAlt: string; caption?: string }>;
  related: string[];
}
interface Props { service: ServiceData; slug: string; }
const { service, slug } = Astro.props as Props;

const SERVICES = [
  { slug: 'kitchen-cabinet-painting-tampa', name: 'Cabinet Painting' },
  { slug: 'kitchen-cabinet-refacing-tampa', name: 'Cabinet Refacing' },
  { slug: 'custom-kitchen-cabinets-tampa', name: 'Custom Cabinets' },
  { slug: 'kitchen-cabinet-installation-tampa', name: 'Cabinet Installation' },
  { slug: 'kitchen-remodeling-tampa', name: 'Kitchen Remodeling' },
];
const AREAS = [
  { slug: 'westchase', name: 'Westchase' }, { slug: 'carrollwood', name: 'Carrollwood' },
  { slug: 'south-tampa', name: 'South Tampa' }, { slug: 'new-tampa', name: 'New Tampa' },
  { slug: 'citrus-park', name: 'Citrus Park' }, { slug: 'brandon', name: 'Brandon' },
  { slug: 'riverview', name: 'Riverview' },
];
const nameFor = (s: string) => SERVICES.find((x) => x.slug === s)?.name ?? s;
const related = (service.related || []).map((s) => ({ slug: s, name: nameFor(s) }));
const sm = (src: string) => src.replace(/\.webp$/, '-sm.webp');

const breadcrumbs = [
  { name: 'Home', url: `${site.url}/` },
  { name: service.breadcrumb, url: `${site.url}/${slug}` },
];
const extraSchema = [
  { schema: 'servicePage', serviceName: service.shortName, serviceSlug: slug, description: service.description },
  { schema: 'breadcrumb', breadcrumbItems: breadcrumbs },
  ...(service.faqItems?.length ? [{ schema: 'faq', faqItems: service.faqItems }] : []),
];
---
<BaseLayout title={service.pageTitle} description={service.description} ogImage={service.heroImage} extraSchema={extraSchema as any}>
  <FloatingCallBadge />
  <main class="min-h-screen bg-gray-50">
    <StickyHeader />

    <!-- Hero -->
    <section class="relative pt-32 pb-20 bg-[#1a2b4a] overflow-hidden">
      <div class="absolute inset-0 z-0 opacity-25">
        <img src={service.heroImage} alt={service.title} loading="eager" fetchpriority="high" decoding="async" class="object-cover absolute inset-0 w-full h-full" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#1a2b4a]/70 to-[#1a2b4a]/95 z-0"></div>
      <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <nav class="mb-6" aria-label="Breadcrumb">
          <ol class="flex items-center justify-center gap-2 text-sm text-gray-400">
            <li><a class="hover:text-white" href="/">Home</a></li>
            <li>/</li>
            <li class="text-white">{service.breadcrumb}</li>
          </ol>
        </nav>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4">{service.title}</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">{service.heroSubtitle}</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#contact" data-cta="service_hero_estimate" class="inline-flex items-center justify-center px-8 py-4 bg-[#c9a227] text-[#1a2b4a] font-bold text-lg rounded-lg hover:bg-[#d4b84a] transition-all">Get a Free Estimate</a>
          <a href={telHref} data-cta="service_hero_call" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-bold text-lg rounded-lg hover:bg-white hover:text-[#1a2b4a] transition-all">Call {site.phoneDisplay}</a>
        </div>
      </div>
    </section>

    <!-- Trust strip -->
    <section class="bg-white border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-sm text-gray-600">
        <span class="flex items-center gap-2"><svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Licensed &amp; Insured</span>
        <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#c9a227]" fill="currentColor" viewBox="0 0 20 20"><path d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Written Workmanship Warranty</span>
        <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#c9a227]" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4zM18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9z"/></svg>Financing Available</span>
        <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#c9a227]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>Backed by {site.sisterName}</span>
      </div>
    </section>

    <!-- Content + Sidebar -->
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-3 gap-12">
          <!-- Main -->
          <div class="lg:col-span-2 order-1 space-y-12">
            <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 lg:p-10">
              <div class="article-content"><slot /></div>
            </article>

            {service.process?.length > 0 && (
              <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 lg:p-10">
                <h2 class="text-2xl font-bold text-[#1a2b4a] mb-8">Our process, step by step</h2>
                <ol class="space-y-6">
                  {service.process.map((step, i) => (
                    <li class="flex gap-4">
                      <span class="flex-shrink-0 w-10 h-10 rounded-full bg-[#1a2b4a] text-[#c9a227] font-bold flex items-center justify-center">{i + 1}</span>
                      <div>
                        <h3 class="font-bold text-[#1a2b4a] mb-1">{step.title}</h3>
                        <p class="text-gray-600 leading-relaxed">{step.description}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            )}

            {service.priceAnchor && (
              <div class="bg-[#1a2b4a] rounded-2xl p-8 text-white flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                  <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-xs mb-1">Pricing</p>
                  <p class="text-xl font-bold">{service.priceAnchor}</p>
                  <p class="text-gray-300 text-sm mt-1">Every kitchen is different. Your free estimate is exact, with no surprises.</p>
                </div>
                <a href="#contact" class="flex-shrink-0 inline-flex items-center justify-center px-6 py-3 bg-[#c9a227] text-[#1a2b4a] font-bold rounded-lg hover:bg-[#d4b84a] transition-all">Get my price</a>
              </div>
            )}

            {service.gallery?.length > 0 && (
              <div id="gallery" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 lg:p-10">
                <h2 class="text-2xl font-bold text-[#1a2b4a] mb-6">Project gallery</h2>
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                  {service.gallery.map((g) => (
                    <div class="cursor-pointer group relative aspect-[4/3] rounded-xl overflow-hidden shadow-md">
                      <img src={g.src} srcset={`${sm(g.src)} 640w, ${g.src} 1280w`} sizes="(max-width:768px) 50vw, 33vw" alt={g.alt} loading="lazy" decoding="async" width="640" height="480" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                      <div class="absolute inset-0 bg-[#1a2b4a]/0 group-hover:bg-[#1a2b4a]/30 transition-colors flex items-center justify-center">
                        <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {service.faqItems?.length > 0 && (
              <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 lg:p-10">
                <h2 class="text-2xl font-bold text-[#1a2b4a] mb-8 flex items-center gap-3">
                  <svg class="w-7 h-7 text-[#c9a227]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  Frequently asked questions
                </h2>
                <div class="space-y-4">
                  {service.faqItems.map((item) => (
                    <details class="group border border-gray-100 rounded-xl overflow-hidden">
                      <summary class="flex items-center justify-between gap-3 cursor-pointer p-5 font-semibold text-[#1a2b4a] hover:bg-gray-50">
                        {item.q}
                        <svg class="w-5 h-5 text-[#c9a227] flex-shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                      </summary>
                      <p class="px-5 pb-5 text-gray-600 leading-relaxed">{item.a}</p>
                    </details>
                  ))}
                </div>
              </div>
            )}

            {related.length > 0 && (
              <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 lg:p-10">
                <h2 class="text-2xl font-bold text-[#1a2b4a] mb-6">Related services</h2>
                <div class="grid sm:grid-cols-3 gap-4">
                  {related.map((r) => (
                    <a href={`/${r.slug}`} class="block p-5 rounded-xl border border-gray-200 hover:border-[#c9a227] hover:shadow-md transition-all group">
                      <span class="font-semibold text-[#1a2b4a] group-hover:text-[#c9a227] transition-colors">{r.name}</span>
                      <span class="block text-[#c9a227] text-sm mt-2">Learn more →</span>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Sidebar -->
          <aside class="lg:col-span-1 order-2 lg:sticky lg:top-24 lg:self-start space-y-6">
            <div class="bg-[#1a2b4a] rounded-xl p-6 text-white">
              <h3 class="text-xl font-bold mb-2">Get your free estimate</h3>
              <p class="text-gray-300 text-sm mb-4">Talk to a real person and get an exact, no-pressure quote.</p>
              <a href={telHref} data-cta="sidebar_call" class="flex items-center justify-center gap-2 w-full py-3 bg-[#c9a227] text-[#1a2b4a] font-bold rounded-lg hover:bg-[#d4b84a] transition-all mb-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                {site.phoneDisplay}
              </a>
              <a href="#contact" class="block text-center w-full py-3 border-2 border-white text-white font-semibold rounded-lg hover:bg-white hover:text-[#1a2b4a] transition-all">Request estimate online</a>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
              <div class="bg-gray-50 px-5 py-4 border-b border-gray-200"><h3 class="font-bold text-[#1a2b4a]">Our Services</h3></div>
              <nav class="divide-y divide-gray-100">
                {SERVICES.map((s) => (
                  s.slug === slug
                    ? <span class="block px-5 py-3 text-sm bg-[#c9a227]/10 text-[#c9a227] font-semibold border-l-4 border-[#c9a227]">{s.name}</span>
                    : <a class="block px-5 py-3 text-sm text-gray-600 hover:bg-gray-50 hover:pl-6 transition-all" href={`/${s.slug}`}>{s.name}</a>
                ))}
              </nav>
            </div>

            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
              <div class="bg-gray-50 px-5 py-4 border-b border-gray-200"><h3 class="font-bold text-[#1a2b4a]">Service Areas</h3></div>
              <nav class="divide-y divide-gray-100">
                {AREAS.map((a) => (
                  <a class="block px-5 py-3 text-sm text-gray-600 hover:bg-gray-50 hover:pl-6 transition-all" href={`/service-areas/${a.slug}`}>{a.name}</a>
                ))}
              </nav>
            </div>

            <div class="bg-gradient-to-br from-gray-50 to-white rounded-xl border border-gray-200 p-5">
              <h3 class="font-bold text-[#1a2b4a] mb-4">Why choose us</h3>
              <ul class="space-y-3 text-sm">
                <li class="flex items-start gap-3"><svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span class="text-gray-600">Factory-smooth, sprayed finishes</span></li>
                <li class="flex items-start gap-3"><svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span class="text-gray-600">Licensed, insured, warrantied</span></li>
                <li class="flex items-start gap-3"><svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span class="text-gray-600">Backed by {site.sisterName}</span></li>
                <li class="flex items-start gap-3"><svg class="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg><span class="text-gray-600">Free, no-pressure estimates</span></li>
              </ul>
            </div>
          </aside>
        </div>
      </div>
    </section>

    <BeforeAfterSlider items={service.beforeAfter || []} background="gray" subheading="Drag to see the transformation." />

    <ContactForm formLocation={`service:${slug}`} />

    <Footer />
  </main>

  <ExitIntentPopup />
  <AnalyticsListeners />
</BaseLayout>
