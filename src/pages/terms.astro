---
import BaseLayout from '../layouts/BaseLayout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
---
<BaseLayout title="Terms of Use | Tampa Kitchen Cabinets" description="The terms that govern your use of the Tampa Kitchen Cabinets website." noindex={true}>
  <main class="bg-white min-h-screen">
    <StickyHeader />
    <section class="pt-32 pb-20">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 article-content">
        <h1 class="text-4xl font-bold text-[#1a2b4a] mb-2">Terms of Use</h1>
        <p class="text-sm text-gray-500 mb-8">Last updated: May 2026</p>
        <p>These terms govern your use of {site.domain}, operated by {site.brandName}, a division of {site.legalEntity}. By using this site, you agree to these terms.</p>
        <h2>Estimates and pricing</h2>
        <p>Any pricing, ranges, or "starting from" figures shown on this website are general guidance only and are not a quote or offer. Project pricing is provided in a written estimate after an in-home consultation, and is governed by your signed contract.</p>
        <h2>Use of the site</h2>
        <p>You may use this site for lawful, personal purposes. You may not copy, scrape, or republish our content, images, or branding without permission.</p>
        <h2>Intellectual property</h2>
        <p>All content, photography, and marks on this site are owned by {site.legalEntity} or used with permission.</p>
        <h2>Third-party links</h2>
        <p>We link to third parties such as our financing partner, Acorn Finance, and our sister company, {site.sisterName}. We are not responsible for the content or practices of third-party sites.</p>
        <h2>Disclaimer</h2>
        <p>This site is provided "as is." To the fullest extent permitted by Florida law, we disclaim warranties regarding the website itself. Workmanship on completed projects is covered by our separate written warranty.</p>
        <h2>Contact</h2>
        <p>Questions about these terms? Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
    </section>
    <Footer />
  </main>
</BaseLayout>
