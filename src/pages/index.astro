---
import BaseLayout from '../layouts/BaseLayout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import PromoBlock from '../components/PromoBlock.astro';
import QuartzEducation from '../components/QuartzEducation.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ThreeWays from '../components/ThreeWays.astro';
import FAQSection from '../components/FAQSection.astro';
import SampleSelections from '../components/SampleSelections.astro';
import GallerySection from '../components/GallerySection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import ServiceAreasGrid from '../components/ServiceAreasGrid.astro';
import CTASection from '../components/CTASection.astro';
import TrustBar from '../components/TrustBar.astro';
import FloatingCallBadge from '../components/FloatingCallBadge.astro';
import ExitIntentPopup from '../components/ExitIntentPopup.astro';
import AnalyticsListeners from '../components/AnalyticsListeners.astro';
import { site, telHref } from '../lib/site';
import home from '../data/home.json';

const extraSchema = [
  { schema: 'localBusiness' },
  { schema: 'servicesCatalog' },
];
const whyUs = [
  { title: 'Plywood, not particle board', body: 'Plywood boxes with dovetail joints and soft-close hinges, built to last 20 to 30 years. Big box stores sell particle board held together with staples.', icon: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343' },
  { title: '5 days, not 5 months', body: 'A complete kitchen, new cabinets and quartz, installed by our own crew in about 5 days. The industry standard for a full remodel is 6 to 12 weeks.', icon: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z' },
  { title: 'See it in 3D first', body: 'We render your exact kitchen in photorealistic 3D before we build anything. The kitchen you approve is the kitchen you get. 61% of homeowners regret a layout choice. You will not.', icon: 'M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z' },
  { title: 'The price quoted is the price paid', body: 'A fixed, written price before we start, with no change orders and no surprise upcharges. Most remodels run over budget. Yours will not.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
];
---
<BaseLayout
  title="Kitchen Cabinets Tampa | 5-Day Install, Quartz From $19,995"
  description="New kitchen cabinets and quartz countertops in Tampa, installed in 5 days. Complete kitchens from $19,995, or $250/month. See your exact kitchen in 3D before we build it."
  extraSchema={extraSchema as any}
>
  <FloatingCallBadge />
  <main>
    <StickyHeader />

    <!-- Hero -->
    <section class="relative min-h-[92vh] flex items-center bg-[#1a2b4a]">
      <img src="/optimized/hero.webp" alt="Custom white shaker kitchen cabinets and island in a Tampa home by Tampa Kitchen Cabinets" fetchpriority="high" loading="eager" decoding="async" width="1200" height="900" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#1a2b4a]/95 via-[#1a2b4a]/80 to-[#1a2b4a]/55"></div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 w-full">
        <div class="max-w-2xl">
          <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-sm mb-4">{home.heroEyebrow}</p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-4">{home.heroH1}</h1>
          <p class="text-2xl sm:text-3xl font-bold text-[#c9a227] mb-4">{home.heroPrice}</p>
          <p class="text-lg sm:text-xl text-gray-200 mb-8 leading-relaxed">{home.heroPromise}</p>
          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="/contact" data-cta="hero_consultation" class="inline-flex items-center justify-center px-8 py-4 bg-[#c9a227] text-[#1a2b4a] font-bold text-lg rounded-lg hover:bg-[#d4b84a] transition-all shadow-lg hover:-translate-y-0.5">See My Kitchen in 3D, Free Consultation</a>
            <a href={telHref} data-cta="hero_call" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-bold text-lg rounded-lg hover:bg-white hover:text-[#1a2b4a] transition-all">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Call {site.phoneDisplay}
            </a>
          </div>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-200">
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#c9a227]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>5-day professional install</span>
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#c9a227]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>3D design included</span>
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#c9a227]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Financing from $250/mo</span>
          </div>
        </div>
      </div>
    </section>

    <TrustBar />

    <!-- No Surprises guarantee (hero-adjacent) -->
    <section class="py-12 bg-[#1a2b4a]">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-sm mb-3">The Tampa Kitchen Cabinets Guarantee</p>
        <p class="text-xl sm:text-2xl text-white font-semibold leading-relaxed">The price we quote is the price you pay. The kitchen we render is the kitchen we build. The timeline we promise is the timeline we keep.</p>
      </div>
    </section>

    <ThreeWays background="white" />

    <!-- Stats -->
    <section class="bg-[#1a2b4a] border-b-4 border-[#c9a227]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        {home.stats.map((s) => (
          <div>
            <p class="text-3xl sm:text-4xl font-extrabold text-[#c9a227]">{s.value}</p>
            <p class="text-gray-300 text-sm mt-1">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    <PromoBlock background="navy" />

    <ServiceGrid />

    <SampleSelections background="white" />

    <BeforeAfterSlider
      items={home.beforeAfter}
      heading="See the remodel"
      subheading="Real Tampa Bay kitchens, from build and installation to the finished result. Drag to compare."
      background="gray"
    />

    <!-- Why us -->
    <section class="py-16 sm:py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-sm mb-2">Why Choose Us</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-[#1a2b4a]">The quality of custom. The speed of refacing. The price of big box.</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {whyUs.map((c) => (
            <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
              <div class="w-12 h-12 rounded-lg bg-[#c9a227]/15 flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-[#c9a227]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={c.icon}/></svg>
              </div>
              <h3 class="font-bold text-[#1a2b4a] mb-2">{c.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{c.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <HowItWorks />
    <QuartzEducation background="white" />
    <GallerySection limit={8} background="gray" />
    <TestimonialsSection />
    <ServiceAreasGrid />
    <FAQSection background="gray" />
    <CTASection title="See your kitchen in 3D, from $250/month" description="Book your free 3D design consultation. We bring the samples to you, render your kitchen in 3D, and give you one clear price." />
    <ContactForm formLocation="homepage" />
    <Footer />
  </main>

  <ExitIntentPopup />
  <AnalyticsListeners />
</BaseLayout>
