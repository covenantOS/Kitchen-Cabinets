---
import BaseLayout from '../layouts/BaseLayout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider.astro';
import PromoBlock from '../components/PromoBlock.astro';
import QuartzEducation from '../components/QuartzEducation.astro';
import HowItWorks from '../components/HowItWorks.astro';
import GallerySection from '../components/GallerySection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import ServiceAreasGrid from '../components/ServiceAreasGrid.astro';
import CTASection from '../components/CTASection.astro';
import TrustBar from '../components/TrustBar.astro';
import FloatingCallBadge from '../components/FloatingCallBadge.astro';
import ExitIntentPopup from '../components/ExitIntentPopup.astro';
import AnalyticsListeners from '../components/AnalyticsListeners.astro';
import { site, telHref } from '../lib/site';
import home from '../data/home.json';

const extraSchema = [
  { schema: 'localBusiness' },
  { schema: 'servicesCatalog' },
];
const whyUs = [
  { title: 'One team, two brands', body: `The same crews and standards as ${site.sisterName}, focused entirely on kitchens and cabinetry.`, icon: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6 0a4 4 0 10-3-6.7' },
  { title: 'Factory-smooth finishes', body: 'Sprayed cabinet finishes that look and last like a brand-new kitchen, not a brushed weekend project.', icon: 'M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343' },
  { title: 'Licensed, insured, warrantied', body: 'Your home is protected and every project is backed by a written workmanship warranty.', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' },
  { title: 'Real people, real answers', body: 'Call and reach a real person who can talk through your kitchen, not a call center or a chatbot.', icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z' },
];
---
<BaseLayout
  title={`${site.brandName} | Custom Cabinets & Kitchen Remodeling`}
  description="Tampa Kitchen Cabinets: kitchen cabinet painting, refacing, custom cabinets, installation, and kitchen remodeling. Free estimates from a trusted local team. A division of Westchase Painting Company."
  extraSchema={extraSchema as any}
>
  <FloatingCallBadge />
  <main>
    <StickyHeader />

    <!-- Hero -->
    <section class="relative min-h-[92vh] flex items-center bg-[#1a2b4a]">
      <img src="/optimized/hero.webp" alt="Custom white shaker kitchen cabinets and island in a Tampa home by Tampa Kitchen Cabinets" fetchpriority="high" loading="eager" decoding="async" width="1200" height="900" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-r from-[#1a2b4a]/95 via-[#1a2b4a]/80 to-[#1a2b4a]/55"></div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 w-full">
        <div class="max-w-2xl">
          <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-sm mb-4">{home.heroEyebrow}</p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-5">{home.heroH1}</h1>
          <p class="text-lg sm:text-xl text-gray-200 mb-8 leading-relaxed">{home.heroPromise}</p>
          <div class="flex flex-col sm:flex-row gap-4 mb-8">
            <a href="/contact" data-cta="hero_estimate" class="inline-flex items-center justify-center px-8 py-4 bg-[#c9a227] text-[#1a2b4a] font-bold text-lg rounded-lg hover:bg-[#d4b84a] transition-all shadow-lg hover:-translate-y-0.5">Get a Free Estimate</a>
            <a href={telHref} data-cta="hero_call" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-bold text-lg rounded-lg hover:bg-white hover:text-[#1a2b4a] transition-all">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Call {site.phoneDisplay}
            </a>
          </div>
          <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-200">
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#c9a227]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>Backed by {site.sisterName} (5.0★)</span>
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#c9a227]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Licensed &amp; Insured</span>
            <span class="flex items-center gap-2"><svg class="w-4 h-4 text-[#c9a227]" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Most kitchens done in about a week</span>
          </div>
        </div>
      </div>
    </section>

    <TrustBar />

    <!-- Stats -->
    <section class="bg-[#1a2b4a] border-b-4 border-[#c9a227]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        {home.stats.map((s) => (
          <div>
            <p class="text-3xl sm:text-4xl font-extrabold text-[#c9a227]">{s.value}</p>
            <p class="text-gray-300 text-sm mt-1">{s.label}</p>
          </div>
        ))}
      </div>
    </section>

    <PromoBlock background="navy" />

    <ServiceGrid />

    <BeforeAfterSlider
      items={home.beforeAfter}
      heading="See the transformation"
      subheading="Real Tampa Bay kitchens, from build and installation to the finished result. Drag to compare."
      background="white"
    />

    <!-- Why us -->
    <section class="py-16 sm:py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-sm mb-2">Why Tampa Bay Trusts Us</p>
          <h2 class="text-3xl sm:text-4xl font-bold text-[#1a2b4a]">Kitchens done right, the first time</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {whyUs.map((c) => (
            <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
              <div class="w-12 h-12 rounded-lg bg-[#c9a227]/15 flex items-center justify-center mb-4">
                <svg class="w-6 h-6 text-[#c9a227]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={c.icon}/></svg>
              </div>
              <h3 class="font-bold text-[#1a2b4a] mb-2">{c.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{c.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Sister-brand attribution -->
    <section class="py-14 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-gray-200 bg-gradient-to-br from-gray-50 to-white p-8 sm:p-10 flex flex-col md:flex-row items-start md:items-center gap-6">
          <div class="flex-shrink-0 w-14 h-14 rounded-xl bg-[#1a2b4a] flex items-center justify-center">
            <svg class="w-7 h-7 text-[#c9a227]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"/></svg>
          </div>
          <div class="flex-1">
            <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-xs mb-1">{site.attribution}</p>
            <h2 class="text-2xl font-bold text-[#1a2b4a] mb-2">The kitchen specialists of {site.sisterName}</h2>
            <p class="text-gray-600">{site.brandName} is a division of {site.legalEntity}, the trusted Tampa Bay painting company. Same owners, same crews, same standards you already know, now focused entirely on cabinets and kitchens. Need walls, exteriors, or whole-home painting too?</p>
          </div>
          <a href={site.sisterUrl} target="_blank" rel="noopener" class="flex-shrink-0 inline-flex items-center gap-2 px-6 py-3 border-2 border-[#1a2b4a] text-[#1a2b4a] font-bold rounded-lg hover:bg-[#1a2b4a] hover:text-white transition-all">
            Visit {site.sisterName}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>
    </section>

    <HowItWorks />
    <QuartzEducation background="white" />
    <GallerySection limit={8} background="gray" />
    <TestimonialsSection />
    <ServiceAreasGrid />
    <CTASection />
    <ContactForm formLocation="homepage" />
    <Footer />
  </main>

  <ExitIntentPopup />
  <AnalyticsListeners />
</BaseLayout>
