---
import BaseLayout from '../layouts/BaseLayout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import FloatingCallBadge from '../components/FloatingCallBadge.astro';
import AnalyticsListeners from '../components/AnalyticsListeners.astro';
import { site, telHref, fullAddress } from '../lib/site';

const extraSchema = [{ schema: 'localBusiness' }];
const mapSrc = `https://www.google.com/maps?q=${site.geo.lat},${site.geo.lng}&z=11&output=embed`;
---
<BaseLayout title="Contact Tampa Kitchen Cabinets | Free Estimates" description="Contact Tampa Kitchen Cabinets for a free kitchen cabinet estimate. Call, email, or request a quote online. Serving Tampa and the surrounding Tampa Bay area." extraSchema={extraSchema as any}>
  <FloatingCallBadge />
  <main class="bg-white">
    <StickyHeader />
    <section class="relative pt-32 pb-16 bg-[#1a2b4a] text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-sm mb-3">Contact Us</p>
        <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">Get your free kitchen estimate</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">Call, email, or send the form below. A real person responds within one business day.</p>
      </div>
    </section>

    <section class="py-12 bg-gray-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 sm:grid-cols-3 gap-6">
        <a href={telHref} data-cta="contact_call" class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 text-center hover:shadow-md transition-all">
          <svg class="w-8 h-8 text-[#c9a227] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <p class="font-bold text-[#1a2b4a]">Call</p>
          <p class="text-gray-600 text-sm mt-1">{site.phoneDisplay}</p>
        </a>
        <a href={`mailto:${site.email}`} class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 text-center hover:shadow-md transition-all">
          <svg class="w-8 h-8 text-[#c9a227] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <p class="font-bold text-[#1a2b4a]">Email</p>
          <p class="text-gray-600 text-sm mt-1 break-all">{site.email}</p>
        </a>
        <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 text-center">
          <svg class="w-8 h-8 text-[#c9a227] mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <p class="font-bold text-[#1a2b4a]">Hours</p>
          <p class="text-gray-600 text-sm mt-1">Mon-Sat phones answered 24/7<br/>Sun 1pm-5pm</p>
        </div>
      </div>
      <p class="text-center text-gray-500 text-sm mt-6 max-w-2xl mx-auto px-4">Serving {fullAddress} and the greater Tampa Bay area, including Westchase, Carrollwood, South Tampa, New Tampa, Citrus Park, Brandon, and Riverview.</p>
    </section>

    <ContactForm formLocation="contact" />

    <section aria-label="Service area map">
      <iframe src={mapSrc} title="Tampa Kitchen Cabinets service area map" width="100%" height="420" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>

    <Footer />
  </main>
  <AnalyticsListeners />
</BaseLayout>
