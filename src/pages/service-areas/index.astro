---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Footer from '../../components/Footer.astro';
import ContactForm from '../../components/ContactForm.astro';
import ServiceAreasGrid from '../../components/ServiceAreasGrid.astro';
import CTASection from '../../components/CTASection.astro';
import FloatingCallBadge from '../../components/FloatingCallBadge.astro';
import ExitIntentPopup from '../../components/ExitIntentPopup.astro';
import AnalyticsListeners from '../../components/AnalyticsListeners.astro';
import { site, telHref } from '../../lib/site';

const breadcrumbs = [
  { name: 'Home', url: `${site.url}/` },
  { name: 'Service Areas', url: `${site.url}/service-areas` },
];
const extraSchema = [
  { schema: 'localBusiness' },
  { schema: 'breadcrumb', breadcrumbItems: breadcrumbs },
];
---
<BaseLayout
  title="Kitchen Cabinet Service Areas in Tampa Bay"
  description="Tampa Kitchen Cabinets serves Westchase, Carrollwood, South Tampa, New Tampa, Citrus Park, Brandon, and Riverview with cabinet painting, refacing, custom cabinets, and remodeling."
  extraSchema={extraSchema as any}
>
  <FloatingCallBadge />
  <main class="min-h-screen bg-white">
    <StickyHeader />
    <section class="relative pt-32 pb-20 bg-[#1a2b4a] text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-sm mb-3">Tampa Bay &amp; Beyond</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-4">Kitchen cabinet service areas</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">{site.brandName} brings cabinet painting, refacing, custom cabinets, installation, and full kitchen remodeling to homes across Tampa and the surrounding communities.</p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#contact" class="inline-flex items-center justify-center px-8 py-4 bg-[#c9a227] text-[#1a2b4a] font-bold text-lg rounded-lg hover:bg-[#d4b84a] transition-all">Get a Free Estimate</a>
          <a href={telHref} class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-bold text-lg rounded-lg hover:bg-white hover:text-[#1a2b4a] transition-all">Call {site.phoneDisplay}</a>
        </div>
      </div>
    </section>

    <ServiceAreasGrid />
    <CTASection title="Don't see your neighborhood?" description="We serve all of Tampa Bay. Call us and we'll let you know how soon we can be out." />
    <ContactForm formLocation="service-areas-index" />
    <Footer />
  </main>
  <ExitIntentPopup />
  <AnalyticsListeners />
</BaseLayout>
