---
import BaseLayout from '../layouts/BaseLayout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import CTASection from '../components/CTASection.astro';
import FloatingCallBadge from '../components/FloatingCallBadge.astro';
import ExitIntentPopup from '../components/ExitIntentPopup.astro';
import AnalyticsListeners from '../components/AnalyticsListeners.astro';
import { site, telHref } from '../lib/site';
import reviews from '../data/reviews.json';

const Star = '<svg class="w-5 h-5 text-[#FBBC05]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>';
---
<BaseLayout title="Reviews | Tampa Kitchen Cabinets" description="Read reviews from Tampa Bay homeowners for the team behind Tampa Kitchen Cabinets, backed by 25+ years of home remodeling experience.">
  <FloatingCallBadge />
  <main class="bg-white">
    <StickyHeader />
    <section class="relative pt-32 pb-16 bg-[#1a2b4a] text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-sm mb-3">Reviews</p>
        <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">What Tampa Bay homeowners say</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">Real homeowners. Real kitchens. Real results across Tampa Bay.</p>
      </div>
    </section>

    <section class="py-10 bg-[#f7f4ed]">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-gray-700">Our team has been transforming Tampa Bay homes for over 25 years. These reviews reflect our consistent commitment to quality, craftsmanship, and customer care across every project we take on.</p>
      </div>
    </section>

    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {reviews.items.map((r) => (
            <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 flex flex-col">
              <div class="flex mb-3">{Array.from({ length: r.rating }).map(() => <Fragment set:html={Star} />)}</div>
              <p class="text-gray-700 leading-relaxed flex-1">&ldquo;{r.text}&rdquo;</p>
              <div class="mt-4 pt-4 border-t border-gray-100">
                <p class="font-semibold text-[#1a2b4a]">{r.name} <span class="font-normal text-gray-500">&bull; {r.location}</span></p>
                <p class="text-xs text-gray-400 mt-0.5">{r.via}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <CTASection title="Want to be our next 5-star review?" description="Get a free estimate and experience the same team Tampa Bay already trusts." />
    <ContactForm formLocation="reviews" />
    <Footer />
  </main>
  <ExitIntentPopup />
  <AnalyticsListeners />
</BaseLayout>
