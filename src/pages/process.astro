---
import BaseLayout from '../layouts/BaseLayout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import FloatingCallBadge from '../components/FloatingCallBadge.astro';
import ExitIntentPopup from '../components/ExitIntentPopup.astro';
import AnalyticsListeners from '../components/AnalyticsListeners.astro';
import { site, telHref } from '../lib/site';

const steps = [
  { title: 'Free consultation and measure', time: '30-45 min', body: 'We visit your home, measure your kitchen precisely, discuss your vision, and show you real material samples, cabinet doors, quartz slabs, and hardware, in your own lighting. You also receive a personal video introduction from your project lead before the visit, so you know exactly who is coming to your home.', points: ['Precise in-home measurement', 'Real samples in your own light', 'Video intro from your project lead'] },
  { title: '3D design and selection', time: '24-48 hrs', body: 'Within 24 to 48 hours we create a photorealistic 3D rendering of your new kitchen using your exact measurements. See every cabinet, every countertop, every detail, and adjust anything you like until it is perfect.', points: ['Photorealistic 3D rendering', 'Built from your exact measurements', 'Adjust until it is perfect'] },
  { title: 'Approval and scheduling', time: 'Same day', body: 'Once you love the design, you approve a fixed price. The price you see is the price you pay. We schedule your installation and order all materials. Your install date is locked in.', points: ['Fixed price you approve', 'The price you see is the price you pay', 'Install date locked in'] },
  { title: 'Material preparation', time: 'Pre-install', body: 'Your cabinets, countertops, hardware, and trim are sourced, quality-checked, and staged. Everything arrives ready to install, with no waiting on back-orders or surprise delays.', points: ['Sourced and quality-checked', 'Staged and ready to install', 'No back-orders or surprise delays'] },
  { title: 'Professional installation, days 1 to 3', time: 'Days 1-3', body: 'Our specialized installation team arrives on schedule. Existing cabinets are carefully removed, and your new cabinetry is precision-installed, leveled, and secured. Crown molding, hardware, and trim are completed.', points: ['Specialized installation team', 'Precision-installed, leveled, secured', 'Crown molding, hardware, and trim'] },
  { title: 'Countertop template and fabrication, days 3 to 5', time: 'Days 3-5', body: 'With cabinets in place, we template your quartz countertops for a perfect fit, then fabricate and install. Backsplash and final connections are completed.', points: ['Quartz templated for a perfect fit', 'Fabricated and installed', 'Backsplash and final connections'] },
  { title: 'Final walkthrough and warranty', time: '30 min', body: 'We walk through every detail together. You verify everything matches your approved 3D design. You receive your written warranty, care instructions, and direct contact information. Welcome to your new kitchen.', points: ['Verify the result matches your design', 'Written warranty and care instructions', 'Direct contact information'] },
];
const stats = [
  { value: '5 days', label: 'Typical install' },
  { value: '3D', label: 'Design before you buy' },
  { value: 'Fixed', label: 'One clear price' },
  { value: 'In writing', label: 'Workmanship warranty' },
];
---
<BaseLayout title="Our Process | Tampa Kitchen Cabinets" description="See exactly how Tampa Kitchen Cabinets works, from your free in-home estimate to the final walk-through and written warranty on your finished kitchen.">
  <FloatingCallBadge />
  <main class="bg-white">
    <StickyHeader />
    <section class="relative pt-32 pb-16 bg-[#1a2b4a] text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-[#c9a227] font-semibold uppercase tracking-wider text-sm mb-3">Our Process</p>
        <h1 class="text-4xl sm:text-5xl font-bold text-white mb-4">How your kitchen transformation works</h1>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">From the first phone call to the final warranty walk-through, here is exactly what happens when you hire {site.brandName}.</p>
      </div>
    </section>

    <section class="bg-[#1a2b4a] border-y-4 border-[#c9a227]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        {stats.map((s) => (<div><p class="text-2xl sm:text-3xl font-extrabold text-[#c9a227]">{s.value}</p><p class="text-gray-300 text-sm mt-1">{s.label}</p></div>))}
      </div>
    </section>

    <section class="py-16">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        {steps.map((s, i) => (
          <div class="flex gap-5 bg-white rounded-2xl border border-gray-100 shadow-sm p-6 sm:p-8">
            <span class="flex-shrink-0 w-12 h-12 rounded-full bg-[#1a2b4a] text-[#c9a227] font-extrabold text-xl flex items-center justify-center">{i + 1}</span>
            <div class="flex-1">
              <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
                <h2 class="text-xl font-bold text-[#1a2b4a]">{s.title}</h2>
                <span class="text-xs font-semibold text-[#c9a227] bg-[#c9a227]/10 px-2.5 py-1 rounded-full">{s.time}</span>
              </div>
              <p class="text-gray-600 leading-relaxed mb-3">{s.body}</p>
              <ul class="grid sm:grid-cols-3 gap-2">
                {s.points.map((p) => (<li class="flex items-start gap-2 text-sm text-gray-600"><svg class="w-4 h-4 text-green-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>{p}</li>))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="py-16 bg-[#1a2b4a] text-center">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-white mb-4">Ready to start your kitchen?</h2>
        <p class="text-xl text-gray-300 mb-8">Book your free in-home estimate today. A real person will walk it with you.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-[#c9a227] text-[#1a2b4a] font-bold rounded-lg hover:bg-[#d4b84a] transition-all">Get a Free Estimate</a>
          <a href={telHref} class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-bold rounded-lg hover:bg-white hover:text-[#1a2b4a] transition-all">Call {site.phoneDisplay}</a>
        </div>
      </div>
    </section>

    <ContactForm formLocation="process" />
    <Footer />
  </main>
  <ExitIntentPopup />
  <AnalyticsListeners />
</BaseLayout>
