# Cloudflare Pages environment variables (set in the Pages dashboard, NOT committed).

# Lead webhook (GoHighLevel / CRM) that receives estimate + exit-intent form
# submissions. Must be the Tampa Kitchen Cabinets webhook, separate from
# Westchase Painting, so leads are attributed correctly (source=tampa-kitchen-cabinets).
GHL_WEBHOOK_CONTACT=https://services.leadconnectorhq.com/hooks/...

# Optional: Google Places API key enables address autocomplete on the estimate form.
# If unset, the form still works; the address field simply has no suggestions.
GOOGLE_MAPS_API_KEY=AIza...
